#!/usr/bin/env python3
"""
update-readme: regenerate the README's command reference from each script's --help.

  update-readme [options]

The scripts are taken from the table at the top of README.adoc, in table order, so a new
script is included once it has a row there. Each script is run with --help and its output
replaces the "== Command reference" section (up to the next "== " heading, or the end of
the file). Everything else in the README is left as it is.

Run it from the dev shell (or with the venv active): the Python scripts import numpy and
astropy before printing their help.

Options:
  -n, --check  change nothing; exit 1 if the command reference is out of date
  -h, --help   show this help

Examples:
  tools/update-readme
  tools/update-readme --check
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
README = REPO / "README.adoc"
HEADING = "== Command reference"


def scripts_from_table(text: str) -> list:
    """Script names from the README table rows: |`+name+` |python |..."""
    return re.findall(r"^\|`\+?([\w-]+)\+?`\s*\|", text, flags=re.MULTILINE)


def help_text(name: str) -> str:
    result = subprocess.run([str(REPO / name), "--help"], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"{name} --help failed (exit {result.returncode}):\n{result.stderr.strip()}")
    return result.stdout.strip("\n")


def build_section(names: list) -> str:
    parts = [f"{HEADING}\n\n"
             "The `+--help+` output of each script (generated by `+tools/update-readme+`).\n"]
    for name in names:
        parts.append(f"=== {name}\n\n[source,text]\n----\n{help_text(name)}\n----\n")
    return "\n".join(parts)


def main():
    p = argparse.ArgumentParser(usage="%(prog)s [options]")
    p.format_help = lambda: __doc__  # --help prints the docstring
    p.add_argument("-n", "--check", action="store_true")
    args = p.parse_args()

    text = README.read_text()
    names = scripts_from_table(text)
    if not names:
        sys.exit("no scripts found in the README table")

    section = build_section(names)
    start = text.find(f"\n{HEADING}\n")
    if start == -1:
        new = text.rstrip("\n") + "\n\n" + section
    else:
        start += 1
        nxt = text.find("\n== ", start + len(HEADING))
        rest = text[nxt + 1:] if nxt != -1 else ""
        new = text[:start] + section + ("\n" + rest if rest else "")

    if new == text:
        print("README.adoc command reference is up to date.")
        return
    if args.check:
        print("README.adoc command reference is out of date; run tools/update-readme.")
        sys.exit(1)
    README.write_text(new)
    print(f"README.adoc command reference updated ({len(names)} scripts).")


if __name__ == "__main__":
    main()
